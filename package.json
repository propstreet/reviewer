{
    "name": "reviewer",
    "version": "3.0.0",
    "description": "A GitHub Action that uses Azure OpenAI to generate PR comments.",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "package": "ncc build src/index.ts -o dist --license LICENSE",
        "lint": "eslint ./src",
        "lint:fix": "eslint ./src --fix",
        "format": "prettier --write ./src",
        "test": "vitest",
        "test-prompts": "cd promptfoo && npx --yes promptfoo@latest eval",
        "view-prompts": "cd promptfoo && npx --yes promptfoo@latest view --yes",
        "coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@actions/core": "^1.11.1",
        "@actions/github": "^6.0.1",
        "@types/minimatch": "^5.1.2",
        "gpt-tokenizer": "^2.9.0",
        "minimatch": "^10.0.1",
        "openai": "^6.9.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.26.0",
        "@types/node": "^22.15.15",
        "@vercel/ncc": "^0.38.3",
        "@vitest/coverage-v8": "^3.1.3",
        "eslint": "^9.26.0",
        "eslint-config-prettier": "^10.1.3",
        "eslint-plugin-prettier": "^5.4.0",
        "globals": "^16.1.0",
        "prettier": "^3.6.2",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.32.0",
        "vitest": "^3.1.3",
        "zod": "^3.24.4"
    }
}
