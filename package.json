{
    "name": "reviewer",
    "version": "2.0.0",
    "description": "A GitHub Action that uses Azure OpenAI to generate PR comments.",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "package": "ncc build src/index.ts -o dist --license LICENSE",
        "lint": "eslint ./src",
        "test": "vitest",
        "test-prompts": "npx --yes promptfoo@latest eval -c promptfoo",
        "view-prompts": "npx --yes promptfoo@latest view --yes",
        "coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@actions/core": "^1.11.1",
        "@actions/github": "^6.0.1",
        "@azure/openai": "^2.0.0",
        "@types/minimatch": "^6.0.0",
        "gpt-tokenizer": "^3.0.1",
        "minimatch": "^10.0.3",
        "openai": "^5.21.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.35.0",
        "@types/node": "^24.5.2",
        "@vercel/ncc": "^0.38.4",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.35.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.4.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.44.0",
        "vitest": "^3.2.4",
        "zod": "^3.25.76"
    }
}
