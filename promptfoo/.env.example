# Azure OpenAI Configuration for promptfoo
# Copy this file to .env and fill in your values

# Azure OpenAI host (without https:// prefix)
AZURE_OPENAI_HOST=my-resource.openai.azure.com

# Azure OpenAI API key
AZURE_API_KEY=your-api-key-here

# Deployment name for reasoning model (GPT-5, o1, o3, etc.)
AZURE_OPENAI_REASONING_DEPLOYMENT=gpt-5
